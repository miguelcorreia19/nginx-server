# Generated by nginx-server (js/fail2ban) at container startup.
# DO NOT EDIT BY HAND — this file is overwritten on every start.
# Tune behaviour via the FAIL2BAN_* environment variables (see README).

[DEFAULT]
# pyinotify is not packaged on Alpine, so the inotify backend is unavailable.
# Polling reads the on-disk nginx logs directly and needs no extra dependency.
backend = polling

bantime  = ${BANTIME}
findtime = ${FINDTIME}
maxretry = ${MAXRETRY}
ignoreip = ${IGNOREIP}

# Installs iptables rules in the container's own network namespace. Requires the
# NET_ADMIN capability (cap_add: [NET_ADMIN]); without it bans cannot take effect.
banaction = iptables-multiport

# --- nginx jails -------------------------------------------------------------
# Both read nginx's error_log. nginx's error_log format is fixed by nginx and is
# therefore unaffected by this project's custom access log_format, so these
# filters work without any custom regex. Access-log-based jails are intentionally
# not used (the project's custom access format would require brittle custom regex).

[nginx-http-auth]
enabled = true
port    = http,https
logpath = /var/log/nginx/error.log

[nginx-botsearch]
enabled = true
port    = http,https
logpath = /var/log/nginx/error.log
